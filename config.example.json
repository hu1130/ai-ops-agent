{
  "app": {
    "name": "internal-ops-agent",
    "environment": "prod",
    "run_type": "normal",
    "cli_run_type": "manual",
    "interval_seconds": 60,
    "database_path": "data/ops_agent.db",
    "dashboard_host": "127.0.0.1",
    "dashboard_port": 8765,
    "api_token": "",
    "api_tokens": [],
    "api_auth_required_for_reads": false
  },
  "projects": [
    {
      "id": "prod",
      "name": "Production",
      "enabled": true,
      "environment": "prod",
      "run_types": ["normal"],
      "description": "Default production monitoring context",
      "tags": ["default"],
      "repo_root": "/opt/your-project",
      "git_remote": "origin",
      "base_branch": "main",
      "health_urls": ["https://example.com/health"],
      "test_commands": ["python -m unittest discover -s tests"],
      "deploy_commands": ["python -m unittest discover -s tests", "systemctl restart your-service"],
      "rollback_commands": ["systemctl restart your-service"],
      "owners": ["ops@example.com"],
      "repair_context_files": ["ops_agent/monitors/http_monitor.py", "tests/test_http_monitor.py"],
      "repair_policy": {
        "auto_approve": false,
        "auto_approve_risks": ["low"],
        "prepare_branch": false,
        "create_pr": false
      }
    }
  ],
  "http_checks": [
    {
      "name": "Example homepage",
      "url": "https://example.com",
      "method": "GET",
      "timeout_seconds": 5,
      "expected_status": 200,
      "max_latency_ms": 3000,
      "required_texts": ["Example"],
      "forbidden_texts": ["系统繁忙", "Internal Server Error"],
      "status_on_content_mismatch": "critical",
      "alert_after_failures": 2,
      "recovery_after_successes": 2,
      "fallback_enabled": true,
      "fallback_urls": ["/login", "/"],
      "fallback_expected_statuses": [200, 204, 301, 302, 401, 403],
      "fallback_success_status": "warning"
    }
  ],
  "json_checks": [
    {
      "name": "AI customer service synthetic chat",
      "url": "https://example.com/v1/chat",
      "interval_seconds": 300,
      "timeout_seconds": 20,
      "expected_status": 200,
      "max_latency_ms": 10000,
      "alert_after_failures": 1,
      "json": {
        "session_id": "ops-agent-probe-{{uuid}}",
        "message": "hello",
        "api_key": ""
      },
      "required_paths": ["messages.0.text"],
      "bad_phrases": ["系统异常", "API key", "服务未启用"]
    }
  ],
  "business_flow_checks": [
    {
      "name": "Example authenticated project flow",
      "enabled": false,
      "interval_seconds": 300,
      "timeout_seconds": 15,
      "max_total_latency_ms": 15000,
      "alert_after_failures": 1,
      "variables": {
        "username": "ops-probe@example.com",
        "password": "change-me"
      },
      "steps": [
        {
          "name": "login",
          "method": "POST",
          "url": "https://example.com/api/login",
          "json": {
            "username": "{{username}}",
            "password": "{{password}}"
          },
          "expected_status": 200,
          "required_json_paths": ["data.token"],
          "extract": {
            "token": "json:data.token"
          }
        },
        {
          "name": "project list",
          "method": "GET",
          "url": "https://example.com/api/projects",
          "headers": {
            "Authorization": "Bearer {{token}}"
          },
          "expected_status": 200,
          "required_json_paths": ["data.projects.0.id"],
          "extract": {
            "project_id": "json:data.projects.0.id"
          }
        },
        {
          "name": "project detail",
          "method": "GET",
          "url": "https://example.com/api/projects/{{project_id}}",
          "headers": {
            "Authorization": "Bearer {{token}}"
          },
          "expected_status": 200,
          "required_json_paths": ["data.id"],
          "forbidden_texts": ["Unauthorized", "Internal Server Error"]
        }
      ]
    }
  ],
  "server_checks": {
    "enabled": true,
    "disk_path": ".",
    "cpu_percent_warn": 85,
    "memory_percent_warn": 85,
    "disk_percent_warn": 90
  },
  "docker_checks": [
    {
      "name": "Example app container",
      "container": "your-container-name",
      "interval_seconds": 60,
      "timeout_seconds": 5,
      "unhealthy_status": "critical",
      "not_running_status": "critical",
      "fallback_urls": ["https://example.com/login"],
      "fallback_success_status": "warning",
      "alert_after_failures": 1
    }
  ],
  "log_checks": [
    {
      "name": "Example project log",
      "path": "logs/app.log",
      "tail_lines": 200,
      "only_new": true,
      "keywords": ["ERROR", "Traceback", "GET /project 500"],
      "status_on_match": "critical",
      "alert_after_failures": 1
    }
  ],
  "ai": {
    "enabled": true,
    "max_log_chars": 4000,
    "repair": {
      "provider": "rules",
      "model": "rule-based-repair-v1",
      "endpoint_url": "https://api.openai.com/v1/chat/completions",
      "api_key_env": "OPS_AGENT_LLM_API_KEY",
      "timeout_seconds": 45,
      "max_prompt_chars": 12000,
      "max_response_chars": 60000,
      "repository_context": {
        "enabled": true,
        "max_files": 8,
        "max_file_chars": 4000,
        "max_total_chars": 16000,
        "max_tree_files": 80,
        "max_file_bytes": 262144
      },
      "policy": {
        "enabled": true,
        "auto_approve": false,
        "auto_approve_risks": ["low"],
        "prepare_branch": false,
        "create_pr": false,
        "max_changed_files": 5,
        "allowed_patch_types": ["unified_diff"],
        "require_human_approval_risks": ["medium", "high", "critical"]
      },
      "auto_trigger": {
        "enabled": false,
        "severities": ["critical"],
        "categories": [
          "service_unavailable",
          "dependency_failure",
          "performance_degraded",
          "probe_config_issue",
          "route_or_healthcheck_config_mismatch",
          "business_flow_failure",
          "synthetic_quality_fail"
        ],
        "excluded_categories": ["unknown", "unclassified"],
        "sources": [],
        "excluded_sources": [],
        "environments": [],
        "run_types": [],
        "min_classification_confidence": 0.65,
        "run_dry_run": true,
        "notify": true,
        "notify_states": ["needs_dry_run", "needs_sandbox", "ready_for_approval", "blocked", "review_only"],
        "notify_limit": 20
      }
    }
  },
  "classification_rules": [
    {
      "name": "example learned slow ai response",
      "enabled": false,
      "category": "performance_degraded",
      "confidence": 0.75,
      "summary": "Configured rule matched a repeated slow AI customer service response.",
      "match": {
        "sources": ["json_api"],
        "statuses": ["warning", "critical"],
        "summary_contains": ["slow", "response"]
      },
      "next_steps": [
        "Check API latency, model provider latency, database connection pool, and recent deployments."
      ]
    }
  ],
  "learning": {
    "enabled": true,
    "interval_seconds": 21600,
    "lookback_hours": 72,
    "max_incidents": 1000,
    "confidence_threshold": 0.65,
    "frequent_occurrence_threshold": 10,
    "frequent_open_category_threshold": 3,
    "min_unknown_count": 1,
    "min_low_confidence_count": 1,
    "notify": false,
    "notification_title": "Ops Agent learning optimization suggestions"
  },
  "retention": {
    "enabled": true,
    "check_results_days": 30,
    "problem_results_days": 90,
    "incidents_days": 90,
    "action_logs_days": 90,
    "api_audit_logs_days": 180,
    "notification_logs_days": 180,
    "test_results_days": 7,
    "test_incidents_days": 7,
    "test_action_logs_days": 7,
    "test_api_audit_logs_days": 7,
    "test_notification_logs_days": 7,
    "auto_close_resolved_incidents": true,
    "auto_close_resolved_after_days": 7,
    "test_auto_close_resolved_after_days": 1,
    "test_environments": ["test"],
    "test_run_types": ["manual_test", "synthetic_test"],
    "cleanup_hour": 3,
    "vacuum": false
  },
  "remediation": {
    "enabled": true,
    "mode": "suggest",
    "allowed_actions": ["check_port", "check_process", "run_diagnostic_command"],
    "allowed_services": [],
    "allowed_containers": [],
    "command_timeout_seconds": 8,
    "max_command_output_chars": 4000,
    "verification": {
      "enabled": true,
      "notify": true,
      "default_wait_seconds": 30,
      "retries": 3,
      "interval_seconds": 5,
      "timeout_seconds": 5
    },
    "guardrails": {
      "min_diagnosis_confidence_for_mutating": 0.8,
      "min_occurrences_for_mutating": 2,
      "diagnosis_required_for_mutating": true,
      "verification_required_for_mutating": true
    },
    "playbooks": [
      {
        "name": "web availability triage",
        "enabled": true,
        "on_failure": "halt",
        "match": {
          "sources": ["http", "json_api", "business_flow"],
          "statuses": ["warning", "critical"],
          "categories": ["service_unavailable", "dependency_failure", "performance_degraded", "business_flow_failure", "synthetic_quality_fail"]
        },
        "steps": [
          {
            "id": "check_target_port",
            "stage": "diagnose",
            "on_failure": "halt",
            "action_type": "check_port",
            "title": "检查目标端口 {{host}}:{{port}}",
            "reason": "{{source}}/{{name}} 访问异常，先确认目标端口是否可连通。",
            "params": {
              "host": "{{host}}",
              "port": "{{port}}",
              "timeout_seconds": 3
            },
            "auto_execute": true
          },
          {
            "id": "inspect_containers",
            "stage": "diagnose",
            "on_failure": "continue",
            "action_type": "run_diagnostic_command",
            "title": "查看容器状态",
            "reason": "{{source}}/{{name}} 异常时，确认容器是否仍在运行。",
            "params": {
              "command": "docker ps --format table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"
            }
          }
        ]
      },
      {
        "name": "probe config triage",
        "enabled": true,
        "on_failure": "continue",
        "match": {
          "categories": ["probe_config_issue"]
        },
        "steps": [
          {
            "id": "verify_probe_url",
            "stage": "diagnose",
            "on_failure": "continue",
            "action_type": "run_diagnostic_command",
            "title": "验证监控探针 {{url}}",
            "reason": "{{source}}/{{name}} 分类为 {{category}}，先确认探针地址、状态码、鉴权和请求方法。",
            "params": {
              "command": "curl -I -L --max-time 10 {{url}}"
            }
          }
        ]
      },
      {
        "name": "disk pressure triage",
        "enabled": true,
        "on_failure": "continue",
        "match": {
          "sources": ["server"],
          "name_contains": ["Disk"]
        },
        "steps": [
          {
            "id": "inspect_disk",
            "stage": "diagnose",
            "on_failure": "continue",
            "action_type": "run_diagnostic_command",
            "title": "查看磁盘占用",
            "reason": "磁盘使用率异常时，先定位磁盘和目录占用。",
            "params": {
              "command": "df -h"
            }
          }
        ]
      },
      {
        "name": "ops-agent guarded restart example",
        "enabled": false,
        "on_failure": "rollback",
        "match": {
          "sources": ["manual"],
          "name_contains": ["ops-agent restart"]
        },
        "steps": [
          {
            "id": "restart_ops_agent",
            "stage": "remediate",
            "on_failure": "rollback",
            "action_type": "restart_service",
            "title": "重启 ops-agent 服务",
            "reason": "示例剧本：人工确认后重启 ops-agent，并在失败时执行回滚诊断。",
            "risk": "medium",
            "params": {
              "service": "ops-agent"
            }
          }
        ],
        "rollback_steps": [
          {
            "id": "inspect_ops_agent_after_failure",
            "stage": "rollback",
            "on_failure": "escalate",
            "action_type": "run_diagnostic_command",
            "title": "查看 ops-agent 状态",
            "reason": "重启失败后查看 systemd 状态，作为回滚诊断信息。",
            "params": {
              "command": "systemctl status ops-agent --no-pager"
            }
          }
        ]
      }
    ],
    "policies": [
      {
        "name": "port checks",
        "action_type": "check_port",
        "enabled": true,
        "targets": ["*"],
        "auto_execute": true,
        "requires_approval": false
      },
      {
        "name": "read-only diagnostics",
        "action_type": "run_diagnostic_command",
        "enabled": true,
        "targets": ["df", "free", "ps", "docker", "journalctl", "tail", "systemctl", "pgrep", "curl"],
        "auto_execute": false,
        "requires_approval": false
      },
      {
        "name": "ops-agent service restart",
        "action_type": "restart_service",
        "enabled": true,
        "targets": ["ops-agent"],
        "auto_execute": false,
        "requires_approval": true,
        "verification_required": true,
        "verify_after": {
          "type": "http",
          "url": "http://127.0.0.1:8765/api/summary",
          "expected_status": 200,
          "wait_seconds": 5,
          "retries": 3,
          "interval_seconds": 5,
          "timeout_seconds": 5
        }
      },
      {
        "name": "docker restart placeholder",
        "action_type": "restart_docker_container",
        "enabled": false,
        "targets": ["your-container-name"],
        "auto_execute": false,
        "requires_approval": true,
        "verification_required": true
      },
      {
        "name": "temp cleanup disabled",
        "action_type": "cleanup_temp_files",
        "enabled": false,
        "targets": ["/tmp"],
        "auto_execute": false,
        "requires_approval": true
      }
    ],
    "actions": {
      "check_port": {
        "auto_execute": true
      },
      "run_diagnostic_command": {
        "auto_execute": false
      },
      "restart_service": {
        "auto_execute": false
      },
      "restart_docker_container": {
        "auto_execute": false
      },
      "cleanup_temp_files": {
        "auto_execute": false
      },
      "rotate_large_log": {
        "auto_execute": false
      }
    }
  },
  "alerts": {
    "webhook_url": "",
    "cooldown_seconds": 300,
    "consecutive_failures": 2,
    "recovery_enabled": true,
    "recovery_after_successes": 1,
    "repeat_notification_enabled": true,
    "repeat_notification_interval_seconds": 3600,
    "escalation_enabled": true,
    "escalation_after_seconds": 1800,
    "escalation_critical_occurrences": 10,
    "default_channels": [],
    "routes": [
      {
        "name": "critical-email",
        "enabled": false,
        "match": {
          "severities": ["critical"]
        },
        "channels": ["email"]
      },
      {
        "name": "ai-api-owner",
        "enabled": false,
        "match": {
          "sources": ["json_api"],
          "categories": ["performance_degraded", "synthetic_quality_fail"]
        },
        "channels": ["email"]
      }
    ],
    "silence_windows": [
      {
        "name": "night-warning-silence",
        "enabled": false,
        "start": "00:00",
        "end": "08:00",
        "timezone": "+08:00",
        "match": {
          "severities": ["warning"]
        }
      }
    ],
    "daily_report": {
      "enabled": true,
      "hour": 9,
      "title": "AI自动化运维工具"
    },
    "diagnostics": {
      "enabled": true,
      "include_logs": true,
      "include_docker": true,
      "max_log_lines": 60,
      "max_log_chars": 6000,
      "command_timeout_seconds": 5
    },
    "email": {
      "enabled": false,
      "smtp_host": "smtp.qq.com",
      "smtp_port": 465,
      "use_ssl": true,
      "use_tls": false,
      "username": "your@qq.com",
      "password": "smtp authorization code",
      "from_email": "your@qq.com",
      "to_emails": ["your@qq.com"]
    }
  }
}
