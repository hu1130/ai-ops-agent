{
  "app": {
    "name": "internal-ops-agent",
    "environment": "prod",
    "run_type": "normal",
    "cli_run_type": "manual",
    "interval_seconds": 60,
    "database_path": "data/ops_agent.db",
    "dashboard_host": "127.0.0.1",
    "dashboard_port": 8765
  },
  "http_checks": [
    {
      "name": "Example homepage",
      "url": "https://example.com",
      "method": "GET",
      "timeout_seconds": 5,
      "expected_status": 200,
      "max_latency_ms": 3000
    }
  ],
  "json_checks": [
    {
      "name": "AI customer service synthetic chat",
      "url": "https://example.com/v1/chat",
      "interval_seconds": 300,
      "timeout_seconds": 20,
      "expected_status": 200,
      "max_latency_ms": 10000,
      "json": {
        "session_id": "ops-agent-probe-{{uuid}}",
        "message": "hello",
        "api_key": ""
      },
      "required_paths": ["messages.0.text"],
      "bad_phrases": ["系统异常", "API key", "服务未启用"]
    }
  ],
  "server_checks": {
    "enabled": true,
    "disk_path": ".",
    "cpu_percent_warn": 85,
    "memory_percent_warn": 85,
    "disk_percent_warn": 90
  },
  "log_checks": [],
  "ai": {
    "enabled": true,
    "max_log_chars": 4000
  },
  "retention": {
    "enabled": true,
    "check_results_days": 30,
    "problem_results_days": 90,
    "incidents_days": 90,
    "action_logs_days": 90,
    "test_results_days": 7,
    "test_incidents_days": 7,
    "test_action_logs_days": 7,
    "test_environments": ["test"],
    "test_run_types": ["manual_test", "synthetic_test"],
    "cleanup_hour": 3,
    "vacuum": false
  },
  "remediation": {
    "enabled": true,
    "mode": "suggest",
    "allowed_actions": ["check_port", "check_process", "run_diagnostic_command"],
    "allowed_services": [],
    "allowed_containers": [],
    "command_timeout_seconds": 8,
    "max_command_output_chars": 4000,
    "verification": {
      "enabled": true,
      "notify": true,
      "default_wait_seconds": 30,
      "retries": 3,
      "interval_seconds": 5,
      "timeout_seconds": 5
    },
    "playbooks": [
      {
        "name": "web availability triage",
        "enabled": true,
        "match": {
          "sources": ["http", "json_api"],
          "statuses": ["warning", "critical"]
        },
        "steps": [
          {
            "action_type": "check_port",
            "title": "检查目标端口 {{host}}:{{port}}",
            "reason": "{{source}}/{{name}} 访问异常，先确认目标端口是否可连通。",
            "params": {
              "host": "{{host}}",
              "port": "{{port}}",
              "timeout_seconds": 3
            },
            "auto_execute": true
          },
          {
            "action_type": "run_diagnostic_command",
            "title": "查看容器状态",
            "reason": "{{source}}/{{name}} 异常时，确认容器是否仍在运行。",
            "params": {
              "command": "docker ps --format table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"
            }
          }
        ]
      },
      {
        "name": "disk pressure triage",
        "enabled": true,
        "match": {
          "sources": ["server"],
          "name_contains": ["Disk"]
        },
        "steps": [
          {
            "action_type": "run_diagnostic_command",
            "title": "查看磁盘占用",
            "reason": "磁盘使用率异常时，先定位磁盘和目录占用。",
            "params": {
              "command": "df -h"
            }
          }
        ]
      }
    ],
    "policies": [
      {
        "name": "port checks",
        "action_type": "check_port",
        "enabled": true,
        "targets": ["*"],
        "auto_execute": true,
        "requires_approval": false
      },
      {
        "name": "read-only diagnostics",
        "action_type": "run_diagnostic_command",
        "enabled": true,
        "targets": ["df", "free", "ps", "docker", "journalctl", "tail", "systemctl", "pgrep"],
        "auto_execute": false,
        "requires_approval": false
      },
      {
        "name": "ops-agent service restart",
        "action_type": "restart_service",
        "enabled": true,
        "targets": ["ops-agent"],
        "auto_execute": false,
        "requires_approval": true,
        "verification_required": true,
        "verify_after": {
          "type": "http",
          "url": "http://127.0.0.1:8765/api/summary",
          "expected_status": 200,
          "wait_seconds": 5,
          "retries": 3,
          "interval_seconds": 5,
          "timeout_seconds": 5
        }
      },
      {
        "name": "docker restart placeholder",
        "action_type": "restart_docker_container",
        "enabled": false,
        "targets": ["your-container-name"],
        "auto_execute": false,
        "requires_approval": true,
        "verification_required": true
      },
      {
        "name": "temp cleanup disabled",
        "action_type": "cleanup_temp_files",
        "enabled": false,
        "targets": ["/tmp"],
        "auto_execute": false,
        "requires_approval": true
      }
    ],
    "actions": {
      "check_port": {
        "auto_execute": true
      },
      "run_diagnostic_command": {
        "auto_execute": false
      },
      "restart_service": {
        "auto_execute": false
      },
      "restart_docker_container": {
        "auto_execute": false
      },
      "cleanup_temp_files": {
        "auto_execute": false
      },
      "rotate_large_log": {
        "auto_execute": false
      }
    }
  },
  "alerts": {
    "webhook_url": "",
    "cooldown_seconds": 300,
    "consecutive_failures": 2,
    "recovery_enabled": true,
    "daily_report": {
      "enabled": true,
      "hour": 9,
      "title": "AI 运维监控日报"
    },
    "diagnostics": {
      "enabled": true,
      "include_logs": true,
      "include_docker": true,
      "max_log_lines": 60,
      "max_log_chars": 6000,
      "command_timeout_seconds": 5
    },
    "email": {
      "enabled": false,
      "smtp_host": "smtp.qq.com",
      "smtp_port": 465,
      "use_ssl": true,
      "use_tls": false,
      "username": "your@qq.com",
      "password": "smtp authorization code",
      "from_email": "your@qq.com",
      "to_emails": ["your@qq.com"]
    }
  }
}
